.git/
.gitignore
.dockerignore

# Local configuration and secrets
.env
.env.*
!.env.example
!.env.*.example
db-seed/.env
docker-run.env
docker-run.env.*
!docker-run.env.example

# Dependencies, build outputs and test artifacts
node_modules/
dist/
coverage/
out/
.cache/
.npm/
*.tsbuildinfo

# Tests are not part of the image. A tests/ folder in the build context is also compiled by
# `nest build` and moves the output to dist/src/main.js, so the image could not start.
test/
tests/

# Local tooling and editor metadata
.agents/
.codex/
.vscode/
diagrams/

# Deployment and local helper scripts
docker-*.sh*
create-release.sh
k8s/
